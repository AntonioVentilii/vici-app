		"1": {
			"name": "macro",
			"cardinality": "one-or-more (one primary)",
			"required": true,
			"closed": true
		},
		"2": {
			"name": "micro",
			"cardinality": "one-or-more (first = primary)",
			"required": true,
			"closed": true
		},
		"3": { "name": "tag", "cardinality": "zero-or-more", "required": false, "closed": false }
	},
