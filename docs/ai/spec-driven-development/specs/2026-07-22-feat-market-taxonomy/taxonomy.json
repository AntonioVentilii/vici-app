{
	"version": 1,
	"note": "3-layer market taxonomy. Layer 1 (macro) and Layer 2 (micro) are CLOSED enums; a market resolves to 1..N macros with exactly one PRIMARY. Layer 3 (tags) is OPEN and OPTIONAL (event/entity level, e.g. bitcoin-etf, super-bowl). Every micro belongs to exactly one macro, so macro is derived from micro. Runtime source of truth is src/lib/constants/market-taxonomy.constants.ts; this JSON mirrors it. The UI renders only macros/micros whose market_tag_index bucket is non-empty.",
	"layers": {
		"1": {
			"name": "macro",
			"cardinality": "one-or-more (one primary)",
			"required": true,
			"closed": true
		},
		"2": {
			"name": "micro",
			"cardinality": "one-or-more (first = primary)",
			"required": true,
			"closed": true
		},
		"3": {
			"name": "tag",
			"cardinality": "zero-or-more",
			"required": false,
			"closed": false
		}
	},
